//PRISMA SCHEMA
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  orders    Order[]
}

model Game {
  id          String    @id @default(uuid())
  title       String
  steamAppId  Int       @unique
  price       Decimal   @db.Decimal(10, 2)
  headerImage String
  createdAt   DateTime  @default(now())
  keys        GameKey[]
  orders      Order[]
}

model GameKey {
  id            String    @id @default(uuid())
  encryptedCode String    // Stores IV + Encrypted Hex
  isSold        Boolean   @default(false)
  soldAt        DateTime?
  gameId        String
  game          Game      @relation(fields: [gameId], references: [id])
  order         Order?

  @@index([gameId, isSold])
}

model Order {
  id              String   @id @default(uuid())
  paymentIntentId String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  gameId          String
  game            Game     @relation(fields: [gameId], references: [id])
  keyId           String   @unique
  key             GameKey  @relation(fields: [keyId], references: [id])
  createdAt       DateTime @default(now())
}